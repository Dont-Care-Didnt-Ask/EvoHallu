+import argparse
+import datetime as dt
+import json
+import subprocess
+import time
+from pathlib import Path
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--deadline", required=True)
+ap.add_argument("--output", type=Path, default=Path("out/campaign/gpu_telemetry.jsonl"))
+args = ap.parse_args()
+deadline = dt.datetime.fromisoformat(args.deadline).timestamp()
+args.output.parent.mkdir(parents=True, exist_ok=True)
+while time.time() < deadline:
+    result = subprocess.run(["nvidia-smi", "--query-gpu=memory.used,utilization.gpu,power.draw,temperature.gpu",
+                             "--format=csv,noheader,nounits"], capture_output=True, text=True)
+    row = {"utc": dt.datetime.now(dt.timezone.utc).isoformat(), "values": result.stdout.strip(),
+           "fields": ["memory_MiB", "utilization_percent", "power_W", "temperature_C"]}
+    with args.output.open("a") as stream:
+        stream.write(json.dumps(row) + "\n")
+    time.sleep(min(60, max(0, deadline - time.time())))
diff --git a/scripts/prepare_formula_ablations.py b/scripts/prepare_formula_ablations.py
new file mode 100644
index 0000000000000000000000000000000000000000..aea8c2b43caf0d4d25465805c1e4b7fc329c64a6
--- /dev/null
+++ b/scripts/prepare_formula_ablations.py
@@ -0,0 +1,105 @@
+"""Freeze interpretable, untuned formula ablations before held-out scoring."""
+import ast
+import copy
+import hashlib
+import json
+import logging
+from pathlib import Path
+
+import numpy as np
+import torch
+from scipy.stats import spearmanr
+from sklearn.metrics import roc_auc_score
+
+from evaluate_cached_claims import load_estimators
+from packing.evaluate.uncertainty_quantification.features import make_all_stats
+from packing.evaluate.uncertainty_quantification.task_uncertainty_quantification import _prepare_train_val_indices
+
+
+def main():
+    logging.getLogger().setLevel(logging.ERROR)
+    torch.set_num_threads(1)
+    root = Path("out/logs/mod1")
+    laguna = root / "uncertainty_quantification_laguna_evo_1048"
+    qwen = root / "uncertainty_quantification_qwen38_evo_1047"
+    variants = {}
+    for name, expression in {
+        "laguna_slope_only": "baseline",
+        "laguna_slope_range": "baseline + 0.25 * normalized_entropy_range",
+        "laguna_slope_variance": "baseline + 0.15 * top1_variance",
+    }.items():
+        tree = ast.parse((laguna / "frozen_estimator.py").read_text())
+        assignments = [n for n in ast.walk(tree) if isinstance(n, ast.Assign) and
+                       any(isinstance(t, ast.Name) and t.id == "final_score" for t in n.targets)]
+        assert len(assignments) == 1
+        assignments[0].value = ast.parse(expression, mode="eval").body
+        variants[name] = laguna, ast.unparse(ast.fix_missing_locations(tree)) + "\n", expression
+    variants["qwen_linear_position_nll"] = qwen, '''import numpy as np
+class HallucinationDetector(Estimator):
+    def __init__(self, context):
+        super().__init__(context, stats_dependencies=["sequence_logprobs"], level="sequence")
+    def __call__(self, stats):
+        result = []
+        for lp in stats["sequence_logprobs"]:
+            nll = -np.asarray(lp, dtype=np.float64)
+            weights = np.arange(1, len(nll)+1, dtype=np.float64)
+            result.append(len(nll)*np.average(nll, weights=weights) if len(nll) else 0.)
+        return np.asarray(result)
+''', "n_tokens * position_weighted_mean_nll; float64 removes half-precision cancellation residuals"
+    paths = []
+    parents = {}
+    for name, (parent, code, expression) in variants.items():
+        destination = root / ("ablation_" + name)
+        destination.mkdir(parents=True, exist_ok=True)
+        path = destination / "frozen_estimator.py"
+        if path.exists() and path.read_text() != code:
+            raise ValueError("Existing ablation differs: " + str(path))
+        path.write_text(code)
+        config = json.loads((parent / "trial_config.json").read_text())
+        config.update(search_mode="frozen_ablation", num_rounds=0)
+        config["trial"]["serving_profile"] = "none"
+        (destination / "trial_config.json").write_text(json.dumps(config, indent=2)+"\n")
+        metadata = {"parent": str(parent / "frozen_estimator.py"),
+                    "parent_sha256": hashlib.sha256((parent / "frozen_estimator.py").read_bytes()).hexdigest(),
+                    "expression": expression, "coefficients_retuned": False,
+                    "held_out_data_read": False, "preparation_partition": "source-model validation"}
+        (destination / "ablation_protocol.json").write_text(json.dumps(metadata, indent=2)+"\n")
+        paths.append(path)
+        parents[name] = metadata
+    raw = torch.load("data/uncertainty_quantification/popqa_train_filtered_10shot_raw_stats_logits.pt",
+                     mmap=True, weights_only=False, map_location="cpu")
+    _, val = _prepare_train_val_indices(raw, 0, .2, 441, "stratified")
+    selected = [raw["samples"][i] for i in val]
+    estimators, _ = load_estimators(paths + [laguna / "frozen_estimator.py", qwen / "frozen_estimator.py"], raw["meta"])
+    estimators = {k:v for k,v in estimators.items() if k.startswith("new/")}
+    scores = {k:[] for k in estimators}
+    labels = []
+    for start in range(0, len(selected), 512):
+        stats, y, _, _ = make_all_stats({"samples": selected[start:start+512], "meta": raw["meta"]}, input_regime="logits")
+        labels.extend(y)
+        for key, estimator in estimators.items():
+            prediction = np.asarray(estimator(copy.deepcopy(stats)))
+            if prediction.shape != (len(y),) or not np.isfinite(prediction).all():
+                raise ValueError("Invalid ablation: " + key)
+            scores[key].extend(prediction)
+    aucs = {key:100*roc_auc_score(labels, values) for key, values in scores.items()}
+    for path in paths:
+        key = "new/"+path.parent.name
+        summary = {"status": "finished", "generator": "frozen_formula_ablation", "requests": 0,
+                   "valid_candidates": 0, "total_tokens": 0, "elapsed_seconds": 0.,
+                   "selected_validation_auc_percent": aucs[key], "held_out_test_evaluated": False}
+        (path.parent / "summary.json").write_text(json.dumps(summary, indent=2)+"\n")
+    qwen_original = scores["new/"+qwen.name]
+    qwen_simple = scores["new/ablation_qwen_linear_position_nll"]
+    report = {"untuned_ablations": parents, "validation_auc_percent": aucs,
+              "qwen_simplification_prediction_spearman": float(spearmanr(qwen_original, qwen_simple).statistic),
+              "qwen_simplification_max_absolute_score_difference": float(np.max(np.abs(np.asarray(qwen_original)-qwen_simple))),
+              "all_training_rows_skip_qwen1048_margin_branch": all(
+                  len(s["top_k_logits"]) == len(s["sequence_logprobs"])+1 for s in raw["samples"]),
+              "training_rows_audited": len(raw["samples"]), "held_out_data_read": False}
+    Path("out/campaign/formula_ablation_preparation.json").write_text(json.dumps(report, indent=2)+"\n")
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/report_campaign.py b/scripts/report_campaign.py
new file mode 100644
index 0000000000000000000000000000000000000000..d34575db880bbbc8576cf8dd6f46e5dac3ab499a
--- /dev/null
+++ b/scripts/report_campaign.py
@@ -0,0 +1,657 @@
+"""Build portable tables and research figures from saved campaign artifacts."""
+from __future__ import annotations
+import ast
+import csv
+import datetime as dt
+import json
+from collections import Counter
+from pathlib import Path
+
+import matplotlib
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
+from matplotlib.backends.backend_pdf import PdfPages
+from scipy.stats import spearmanr, rankdata
+
+
+def read_records(path):
+    rows = []
+    if path.exists():
+        for line in path.read_text().splitlines():
+            try:
+                rows.append(json.loads(line))
+            except json.JSONDecodeError:
+                # A live backup may contain an incomplete final append.
+                continue
+    return rows
+
+
+def macro_results(directory):
+    aggregate_file = directory / "all_datasets.json"
+    aggregate = json.loads(aggregate_file.read_text()) if aggregate_file.exists() else {}
+    macro = {}
+    if len(aggregate) != 9:
+        return aggregate, macro
+    methods = set.intersection(*(set(data["methods"]) for data in aggregate.values()))
+    bootstrap = {name: np.load(directory / (name + "_bootstrap.npz")) for name in aggregate
+                 if (directory / (name + "_bootstrap.npz")).exists()}
+    baseline_name = "original/SequenceLogProb"
+    baseline = np.mean([d["methods"][baseline_name]["auc_percent"] for d in aggregate.values()])
+    for method in sorted(methods):
+        values = [d["methods"][method]["auc_percent"] for d in aggregate.values()]
+        record = {"macro_auc_percent": float(np.mean(values)), "gain_pp": float(np.mean(values)-baseline),
+                  "duplicate_disjoint_macro_auc_percent": float(np.mean([
+                      d["methods"][method]["duplicate_disjoint_auc_percent"] for d in aggregate.values()]))}
+        if len(bootstrap) == 9 and all(method in b.files for b in bootstrap.values()):
+            b = np.stack([bootstrap[name][method] for name in aggregate]).mean(axis=0)
+            ref = np.stack([bootstrap[name][baseline_name] for name in aggregate]).mean(axis=0)
+            record["macro_auc_ci95_percent"] = (100*np.nanpercentile(b, [2.5, 97.5])).tolist()
+            record["paired_macro_gain_ci95_pp"] = (100*np.nanpercentile(b-ref, [2.5, 97.5])).tolist()
+        macro[method] = record
+    for saved in bootstrap.values():
+        saved.close()
+    return aggregate, macro
+
+
+def paired_macro_difference(left_dir, right_dir, left_data, right_data, left, right):
+    """Pair saved draws only after confirming identical ordered resampling units."""
+    if set(left_data) != set(right_data) or len(left_data) != 9:
+        return None
+    draws = []
+    for name in left_data:
+        if left_data[name].get("bootstrap_unit") != right_data[name].get("bootstrap_unit"):
+            return None
+        try:
+            with np.load(left_dir / (name+"_scores.npz")) as a, np.load(right_dir / (name+"_scores.npz")) as b:
+                if not all(np.array_equal(a[key], b[key]) for key in
+                           ["labels", "claim_group_ids", "duplicate_disjoint_mask"]):
+                    return None
+            with np.load(left_dir / (name+"_bootstrap.npz")) as a, np.load(right_dir / (name+"_bootstrap.npz")) as b:
+                if left not in a.files or right not in b.files or a[left].shape != b[right].shape:
+                    return None
+                draws.append(a[left]-b[right])
+        except (FileNotFoundError, KeyError):
+            return None
+    return (100*np.nanpercentile(np.stack(draws).mean(axis=0), [2.5, 97.5])).tolist()
+
+
+def method_label(name):
+    if name == "original/SequenceLogProb":
+        return "Full-template NLL baseline"
+    if name == "alignment/ClaimOnlySequenceLogProb":
+        return "Claim-only NLL baseline"
+    if name.startswith("original/"):
+        return "Best supplied formula (validation)"
+    if name.startswith("supervised/"):
+        label = "Logistic" if "logistic" in name else "QDA"
+        count = 14 if "documented" in name else 17
+        return f"{label} ({count} fixed features)"
+    if "linear" in name:
+        return "Coefficient search (17-feature pool)"
+    if "qwen38" in name:
+        return "Qwen3.8-27B writer"
+    if "laguna" in name:
+        return "Laguna XS 2.1 writer"
+    if "qwen35_4b" in name:
+        return "Qwen3.5-4B writer"
+    if "qwen35" in name:
+        return "Qwen3.5-9B writer"
+    if "devstral" in name:
+        return "Devstral Small 2 writer (published FP8)"
+    return name
+
+
+def select_primary_runs(runs):
+    """Choose source-validation winners before considering test availability."""
+    chosen = []
+    for model in sorted({r["model"] for r in runs}):
+        eligible = [r for r in runs if r["model"] == model and r["search_mode"] == "evolution"
+                    and r["split"] == "stratified" and r["status"] == "finished" and not r.get("protocol_excluded", False) and "pilot" not in r["run"]]
+        if eligible:
+            chosen.append(max(eligible, key=lambda r:r["validation_auc_percent"])["run"])
+    linear = [r for r in runs if r["search_mode"] == "fixed_feature_linear_evolution" and r["status"] == "finished"]
+    if linear:
+        chosen.append(max(linear, key=lambda r:r["validation_auc_percent"])["run"])
+    return chosen
+
+
+def dataset_label(name):
+    group, stem = name.split("__", 1)
+    if group == "geometry":
+        return {"cities":"Cities", "common_claim_true_false":"CommonClaim",
+                "companies_true_false":"Companies", "counterfact_true_false":"CounterFact"}.get(stem,stem)
+    if group.startswith("UHEAD"):
+        return "UHEAD"
+    return {"popqa":"PopQA", "x-fact":"X-Fact", "WildHallucinations":"WildHall"}.get(group,group)
+
+
+def main():
+    output = Path("results")
+    figures = output / "figures"
+    figures.mkdir(parents=True, exist_ok=True)
+    runs, trajectories = [], {}
+    for summary_path in sorted(Path("out/logs/mod1").glob("*/summary.json")):
+        directory = summary_path.parent
+        summary = json.loads(summary_path.read_text())
+        config_path = directory / "trial_config.json"
+        config = json.loads(config_path.read_text()) if config_path.exists() else {}
+        records = read_records(directory / "candidates.jsonl")
+        row = {"run": directory.name, "status": summary["status"],
+               "model": config.get("model", {}).get("hf_model_id", "fixed feature pool"),
+               "search_mode": config.get("search_mode", summary.get("generator", "unknown")),
+               "seed": config.get("seed", summary.get("seed")),
+               "split": config.get("task", {}).get("split_strategy", "stratified"),
+               "serving_profile": config.get("trial", {}).get("serving_profile", "vllm_eager") if config else "none",
+               "writer_weight_precision": config.get("model", {}).get("weight_precision", "bfloat16") if config else "none",
+               "requested_rounds": config.get("num_rounds"),
+               "requests": summary.get("requests", 0),
+               "valid_candidates": summary.get("valid_candidates", summary.get("generated_candidates", 0)),
+               "validation_auc_percent": summary.get("selected_validation_auc_percent", summary.get("best_validation_auc_percent")),
+               "elapsed_seconds": summary.get("elapsed_seconds"), "reported_tokens": summary.get("total_tokens", 0)}
+        exclusion = directory / "exclude_from_evaluation.json"
+        row["protocol_excluded"] = exclusion.exists()
+        if exclusion.exists():
+            row["protocol_exclusion"] = json.loads(exclusion.read_text())
+        row["requests_without_usage"] = sum(not r.get("usage") for r in records)
+        valid = [r for r in records if "score" in r.get("val", {})]
+        row["invalid_candidate_errors"] = dict(Counter(
+            r.get("error") or r.get("train", {}).get("error") or
+            r.get("val", {}).get("error") or "Unspecified evaluation failure"
+            for r in records if "score" not in r.get("val", {})))
+        row["valid_request_fraction"] = len(valid) / len(records) if records else None
+        if len(valid) >= 5:
+            complexity = [sum(1 for _ in ast.walk(ast.parse(r["code"]))) for r in valid]
+            auc = [r["val"]["score"] for r in valid]
+            if len(set(complexity)) > 1 and len(set(auc)) > 1:
+                row["complexity_validation_spearman"] = float(spearmanr(complexity, auc).statistic)
+            row["mean_train_validation_gap_pp"] = float(np.mean([r["train"]["score"]-r["val"]["score"] for r in valid]))
+        prediction_vectors = []
+        for candidate in valid:
+            saved = candidate.get("val_scores_file")
+            if saved and Path(saved).exists():
+                vector = np.load(saved)
+                if np.std(vector) > 0:
+                    prediction_vectors.append(vector)
+        if len(prediction_vectors) >= 2:
+            ranks = rankdata(np.stack(prediction_vectors), axis=1)
+            corr = np.corrcoef(ranks)
+            triangle = corr[np.triu_indices(len(corr), 1)]
