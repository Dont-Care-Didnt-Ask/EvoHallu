+++ b/scripts/audit_claim_data.py
@@ -0,0 +1,46 @@
+"""Audit the supplied splits without exposing individual claim text."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+import pandas as pd
+from sklearn.model_selection import train_test_split
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--root", type=Path, default=Path("data/claims"))
+    ap.add_argument("--output", type=Path, default=Path("results/dataset_audit.json"))
+    args = ap.parse_args()
+    report, claim_sets = [], {}
+    for path in sorted(args.root.rglob("*.csv")):
+        df = pd.read_csv(path, usecols=["claim", "is_hallu"])
+        labels = pd.to_numeric(df.is_hallu, errors="raise")
+        if not set(labels.unique()) <= {0, 1}:
+            raise ValueError(f"Nonbinary labels: {path}")
+        claims = df.claim.fillna("").astype(str).str.split().str.join(" ").str.casefold()
+        name = str(path.relative_to(args.root))
+        claim_sets[name] = set(claims)
+        grouped = pd.DataFrame({"claim": claims, "label": labels}).groupby("claim").label.nunique()
+        row = {"file": name, "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
+               "rows": len(df), "class_counts": {str(int(k)): int(v) for k, v in labels.value_counts().items()},
+               "empty_claims": int(claims.eq("").sum()), "duplicate_claim_rows": int(claims.duplicated().sum()),
+               "contradictory_claims": int(grouped.gt(1).sum())}
+        if "popqa_train" in name:
+            train, val = train_test_split(df.index.to_numpy(), test_size=0.2, stratify=labels, random_state=441)
+            row.update(train_rows=len(train), validation_rows=len(val),
+                       train_validation_claim_overlap=len(set(claims.iloc[train]) & set(claims.iloc[val])))
+        report.append(row)
+    train_name = next(k for k in claim_sets if "popqa_train" in k)
+    for row in report:
+        if row["file"] != train_name:
+            row["overlap_with_popqa_train_claims"] = len(claim_sets[train_name] & claim_sets[row["file"]])
+    result = {"split_seed": 441, "validation_fraction": 0.2, "datasets": report}
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2) + "\n")
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/audit_formulas.py b/scripts/audit_formulas.py
new file mode 100644
index 0000000000000000000000000000000000000000..a1931a960c67e710f36027f5a152d59ec6a805db
--- /dev/null
+++ b/scripts/audit_formulas.py
@@ -0,0 +1,75 @@
+"""Structural and invariance diagnostics; synthetic scores are not AUC evidence."""
+import ast
+import copy
+import inspect
+import json
+import time
+from pathlib import Path
+
+import numpy as np
+from scipy.special import logsumexp, softmax
+from scipy.stats import spearmanr
+
+from packing.evaluate.uncertainty_quantification import found_formulas
+
+
+def main():
+    rng = np.random.default_rng(441)
+    stats = {k: [] for k in ["sequence_logprobs", "greedy_logprobs", "token_entropies", "top_k_logits", "top_k_indices"]}
+    for _ in range(128):
+        length = int(rng.integers(3, 80))
+        logits = rng.normal(0, rng.uniform(0.5, 3.0), (length, 1024))
+        order = np.argsort(logits, axis=1)[:, ::-1][:, :512]
+        top = np.take_along_axis(logits, order, axis=1)
+        lp = logits - logsumexp(logits, axis=1, keepdims=True)
+        token = rng.integers(0, 1024, length - 1)
+        stats["sequence_logprobs"].append(lp[np.arange(length - 1), token].astype(np.float32))
+        stats["greedy_logprobs"].append(lp.max(axis=1).astype(np.float32))
+        stats["token_entropies"].append(-(np.exp(lp) * lp).sum(axis=1).astype(np.float32))
+        stats["top_k_logits"].append(top.astype(np.float32))
+        stats["top_k_indices"].append(order)
+    rows, predictions = [], {}
+    for name, cls in inspect.getmembers(found_formulas, inspect.isclass):
+        if cls.__module__ != found_formulas.__name__:
+            continue
+        source = inspect.getsource(cls)
+        tree = ast.parse(source)
+        row = {"name": name, "lines": len(source.splitlines()), "ast_nodes": sum(1 for _ in ast.walk(tree))}
+        try:
+            started = time.perf_counter()
+            estimator = cls({"supervised": False})
+            full = np.asarray(estimator(copy.deepcopy(stats)), dtype=float)
+            row["seconds_128_samples"] = time.perf_counter() - started
+            row["finite"] = bool(full.shape == (128,) and np.isfinite(full).all())
+            pieces = [np.asarray(estimator({k: v[i:i+16] for k, v in copy.deepcopy(stats).items()})) for i in range(0, 128, 16)]
+            chunked = np.concatenate(pieces)
+            row["chunk_invariant"] = bool(np.allclose(full, chunked, rtol=1e-5, atol=1e-6))
+            shifted = copy.deepcopy(stats)
+            shifted["top_k_logits"] = [a + rng.uniform(-10, 10, (len(a), 1)) for a in shifted["top_k_logits"]]
+            changed = np.asarray(estimator(shifted))
+            row["logit_shift_invariant"] = bool(np.allclose(full, changed, rtol=1e-4, atol=1e-5))
+            row["logit_shift_rank_correlation"] = float(spearmanr(full, changed).statistic)
+            predictions[name] = full
+        except Exception as exc:
+            row["error"] = f"{type(exc).__name__}: {exc}"
+        rows.append(row)
+    pairs = []
+    names = sorted(predictions)
+    for i, first in enumerate(names):
+        for second in names[i + 1:]:
+            rho = float(spearmanr(predictions[first], predictions[second]).statistic)
+            if abs(rho) >= 0.995:
+                pairs.append({"first": first, "second": second, "spearman": rho})
+    result = {"data": "synthetic diagnostics only; no hallucination-quality conclusions",
+              "seed": 441, "samples": 128, "methods": rows, "nearly_identical_rankings": pairs}
+    output = Path("results/formula_diagnostics.json")
+    output.parent.mkdir(exist_ok=True)
+    output.write_text(json.dumps(result, indent=2, allow_nan=False) + "\n")
+    print(json.dumps({"methods": len(rows), "failed": [r["name"] for r in rows if "error" in r],
+                      "batch_dependent": [r["name"] for r in rows if r.get("chunk_invariant") is False],
+                      "logit_shift_dependent": [r["name"] for r in rows if r.get("logit_shift_invariant") is False],
+                      "nearly_identical_pairs": len(pairs)}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/audit_frozen_estimators.py b/scripts/audit_frozen_estimators.py
new file mode 100644
index 0000000000000000000000000000000000000000..78375befe3ac87c15c37949de0dc91a382146e27
--- /dev/null
+++ b/scripts/audit_frozen_estimators.py
@@ -0,0 +1,55 @@
+"""Record frozen-source identity and inspect calls for RNG or external I/O.
+
+This is a reproducibility audit, not a general Python sandbox or safety proof.
+It never repairs a generated program or chooses a replacement winner.
+"""
+import ast
+import datetime as dt
+import hashlib
+import json
+from pathlib import Path
+
+
+def dotted(node):
+    if isinstance(node, ast.Name):
+        return node.id
+    if isinstance(node, ast.Attribute):
+        return dotted(node.value)+"."+node.attr
+    return ""
+
+
+def main():
+    records = []
+    for path in sorted(Path("out/logs/mod1").glob("*/frozen_estimator.py")):
+        text = path.read_text()
+        tree = ast.parse(text)
+        summary = json.loads((path.parent / "summary.json").read_text())
+        calls = sorted({dotted(node.func) for node in ast.walk(tree) if isinstance(node, ast.Call)})
+        suspicious = [name for name in calls if name in {"open", "exec", "eval", "__import__", "np.load", "np.save", "np.savez"}
+                      or name.startswith(("np.random.", "numpy.random.", "random.", "os.", "subprocess.", "requests.", "urllib.", "torch.rand"))]
+        imports = sorted({node.module for node in ast.walk(tree) if isinstance(node, ast.ImportFrom) and node.module}
+                         | {alias.name for node in ast.walk(tree) if isinstance(node, ast.Import) for alias in node.names})
+        candidate_file = path.parent / "candidates.jsonl"
+        selected = summary.get("selected_candidate")
+        matching = None
+        if candidate_file.exists() and selected != "baseline":
+            candidates = [json.loads(line) for line in candidate_file.read_text().splitlines()]
+            candidates = [c for c in candidates if c.get("code_hash") == selected]
+            matching = any(c.get("imports", "")+"\n"+c["code"]+"\n" == text for c in candidates)
+        row = {"run": path.parent.name, "file_sha256": hashlib.sha256(text.encode()).hexdigest(),
+               "selected_candidate": selected, "matches_selected_record": matching,
+               "baseline_retained": selected == "baseline", "imports": imports,
+               "rng_or_external_io_calls_found": suspicious,
+               "excluded_from_quality_evaluation": (path.parent / "exclude_from_evaluation.json").exists()}
+        records.append(row)
+        if matching is False:
+            raise ValueError("Frozen source does not match its selected candidate: " + str(path))
+    result = {"utc": dt.datetime.now(dt.timezone.utc).isoformat(), "estimators": records,
+              "scope": "Static call/import inspection and exact equality to the recorded selected program; no program modifications"}
+    Path("results/frozen_estimator_audit.json").write_text(json.dumps(result, indent=2)+"\n")
+    print(json.dumps({"frozen_estimators": len(records), "source_mismatches": 0,
+                      "runs_with_flagged_calls": [r["run"] for r in records if r["rng_or_external_io_calls_found"]]}))
+
+
+if __name__ == "__main__":
+    main()
