+++ b/scripts/rotate_checkpoint.py
@@ -0,0 +1,32 @@
+"""Remove only downloaded weight shards, preserving provenance and tokenizers."""
+import argparse
+import json
+from pathlib import Path
+
+ap = argparse.ArgumentParser()
+ap.add_argument("directory", type=Path)
+args = ap.parse_args()
+manifest = args.directory / "download_manifest.json"
+if not manifest.is_file():
+    raise ValueError(f"No download provenance at {manifest}")
+allowed = (Path("/dev/shm/mod1-models"), Path("/workspace/mod1-models"))
+directory = args.directory.resolve()
+if not any(directory.is_relative_to(base) for base in allowed):
+    raise ValueError("Refusing to rotate a directory outside this campaign's model staging areas")
+total = 0
+for row in json.loads(manifest.read_text())["files"]:
+    if not row["file"].endswith(".safetensors"):
+        continue
+    path = args.directory / row["file"]
+    if path.is_symlink():
+        target = path.resolve()
+        if not target.is_relative_to(Path("/workspace/mod1-model-spill")):
+            raise ValueError(f"Unexpected shard target: {target}")
+        if target.exists():
+            total += target.stat().st_size
+            target.unlink()
+        path.unlink()
+    elif path.exists():
+        total += path.stat().st_size
+        path.unlink()
+print(json.dumps({"model_directory": str(args.directory), "released_bytes": total}))
diff --git a/scripts/search_linear_controls.py b/scripts/search_linear_controls.py
new file mode 100644
index 0000000000000000000000000000000000000000..60ed97c3e82ab8dcbb038f5ea156e999857764f3
--- /dev/null
+++ b/scripts/search_linear_controls.py
@@ -0,0 +1,96 @@
+"""Cheap, label-guided search of fixed formulas, without an LLM or fitted model.
+
+Uses a fixed human-designed feature pool. It is a restricted-search comparator,
+not a claim that this pool and open-ended program generation are equivalent.
+"""
+import argparse
+import json
+import logging
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+from sklearn.metrics import roc_auc_score
+
+from packing.evaluate.uncertainty_quantification.features import make_all_stats
+from packing.evaluate.uncertainty_quantification.task_uncertainty_quantification import _prepare_train_val_indices
+from packing.evaluate.uncertainty_quantification.supervised_baselines import compact_features, FEATURE_NAMES
+
+SCALES = np.array([30., 100., 5., 3., 15., 10., 2., 5., 5., 5., 3., 3., 1., 5., 6., 5., 5.])
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--raw", default="data/uncertainty_quantification/popqa_train_filtered_10shot_raw_stats_logits.pt")
+    ap.add_argument("--candidates", type=int, default=60)
+    args = ap.parse_args()
+    logging.getLogger().setLevel(logging.ERROR)
+    torch.set_num_threads(1)
+    raw = torch.load(args.raw, mmap=True, weights_only=False, map_location="cpu")
+    train, val = _prepare_train_val_indices(raw, 0, .2, 441)
+    features, labels = [], []
+    for start in range(0, len(raw["samples"]), 512):
+        stats, y, _, _ = make_all_stats({"samples": raw["samples"][start:start+512], "meta": raw["meta"]}, input_regime="logits")
+        features.append(compact_features(stats))
+        labels.extend(y)
+    X, y = np.concatenate(features) / SCALES, np.asarray(labels)
+    for mode in ["independent", "evolution"]:
+        for seed in [1048, 1047]:
+            started = time.monotonic()
+            rng = np.random.default_rng(seed)
+            parent = np.zeros(len(FEATURE_NAMES))
+            parent[1] = 1.
+            best_train = roc_auc_score(y[train], (X @ parent)[train])
+            rows = [{"candidate": -1, "weights": parent.tolist(), "train_auc": float(best_train),
+                     "validation_auc": float(roc_auc_score(y[val], (X @ parent)[val]))}]
+            for index in range(args.candidates):
+                if mode == "independent" or rng.random() < .25:
+                    weights = np.zeros(len(FEATURE_NAMES))
+                    chosen = rng.choice(len(weights), size=int(rng.integers(1, 4)), replace=False)
+                    weights[chosen] = rng.normal(size=len(chosen))
+                else:
+                    weights = parent.copy()
+                    feature = int(rng.integers(len(weights)))
+                    weights[feature] += rng.normal(scale=.5)
+                    nonzero = np.flatnonzero(weights)
+                    if len(nonzero) > 3:
+                        drop = min(nonzero, key=lambda i: abs(weights[i]))
+                        weights[drop] = 0
+                scores = X @ weights
+                train_auc = float(roc_auc_score(y[train], scores[train]))
+                val_auc = float(roc_auc_score(y[val], scores[val]))
+                rows.append({"candidate": index, "weights": weights.tolist(),
+                             "train_auc": train_auc, "validation_auc": val_auc})
+                if train_auc > best_train:
+                    best_train, parent = train_auc, weights.copy()
+            winner = max(rows, key=lambda r: r["validation_auc"])
+            selected = np.array(winner["weights"])
+            run = Path("out/logs/mod1") / f"uncertainty_quantification_linear_{mode}_{seed}"
+            run.mkdir(parents=True, exist_ok=True)
+            code = f'''from packing.evaluate.uncertainty_quantification.supervised_baselines import compact_features
+class HallucinationDetector(Estimator):
+    def __init__(self, context):
+        super().__init__(context, stats_dependencies=["sequence_logprobs", "token_entropies", "top_k_logits"], level="sequence")
+    def __call__(self, stats):
+        weights = np.array({selected.tolist()!r})
+        scales = np.array({SCALES.tolist()!r})
+        return (compact_features(stats) / scales) @ weights
+'''
+            (run / "frozen_estimator.py").write_text(code)
+            (run / "linear_candidates.json").write_text(json.dumps(rows, indent=2) + "\n")
+            np.save(run / "selected_val_scores.npy", (X @ selected)[val])
+            summary = {"status": "finished", "generator": "fixed_feature_linear_" + mode,
+                       "seed": seed, "generated_candidates": args.candidates,
+                       "selected_validation_auc_percent": 100 * winner["validation_auc"],
+                       "selected_train_auc_percent": 100 * winner["train_auc"],
+                       "selected_features": {FEATURE_NAMES[i]: float(selected[i]) for i in np.flatnonzero(selected)},
+                       "elapsed_seconds": time.monotonic() - started, "total_tokens": 0,
+                       "held_out_test_evaluated": False, "feature_pool": FEATURE_NAMES,
+                       "feature_scales": SCALES.tolist()}
+            (run / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+            print(json.dumps({"mode": mode, "seed": seed, "validation_auc_percent": summary["selected_validation_auc_percent"]}), flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/stop_own_pod.py b/scripts/stop_own_pod.py
new file mode 100644
index 0000000000000000000000000000000000000000..24908bf3ffd6449caf1b5efa079e4c3caed36fbe
--- /dev/null
+++ b/scripts/stop_own_pod.py
@@ -0,0 +1,49 @@
+"""Read or stop only the current, explicitly identified Runpod pod.
+
+The injected credential stays on the pod and is never included in output.
+Use --execute only after experiment artifacts have been backed up elsewhere.
+"""
+import argparse
+import json
+from pathlib import Path
+import urllib.error
+import urllib.request
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--expected-id", required=True)
+    parser.add_argument("--expected-name", required=True)
+    parser.add_argument("--execute", action="store_true")
+    args = parser.parse_args()
+    values = dict(item.decode().split("=", 1) for item in Path("/proc/1/environ").read_bytes().split(b"\0") if b"=" in item)
+    if values.get("RUNPOD_POD_ID") != args.expected_id:
+        raise SystemExit("Current container does not match the expected pod")
+
+    def request(query):
+        req = urllib.request.Request("https://api.runpod.io/graphql", data=json.dumps({"query": query}).encode(),
+                                     headers={"Content-Type": "application/json",
+                                              "Authorization": "Bearer " + values["RUNPOD_API_KEY"]})
+        try:
+            with urllib.request.urlopen(req, timeout=25) as response:
+                result = json.load(response)
+        except urllib.error.HTTPError as exc:
+            raise SystemExit(f"Runpod management request returned HTTP {exc.code}") from None
+        if result.get("errors"):
+            # Only report server messages, never the authenticated request.
+            raise SystemExit(json.dumps({"errors": [e.get("message") for e in result["errors"]]}))
+        return result["data"]
+
+    pod = request('query { pod(input: {podId: ' + json.dumps(args.expected_id) + '}) { id name desiredStatus costPerHr } }')["pod"]
+    if not pod or pod["id"] != args.expected_id or pod["name"] != args.expected_name:
+        raise SystemExit("Pod identity verification failed")
+    print(json.dumps({"verified_current_pod": pod}), flush=True)
+    if args.execute:
+        result = request('mutation { podStop(input: {podId: ' + json.dumps(args.expected_id) + '}) { id desiredStatus } }')
+        print(json.dumps(result), flush=True)
+        if result["podStop"]["desiredStatus"] != "EXITED":
+            raise SystemExit("Stop response did not confirm EXITED")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/stop_remote_pod.py b/scripts/stop_remote_pod.py
new file mode 100644
index 0000000000000000000000000000000000000000..85cfda55aa33fd9018f785699909b243db0e0e90
--- /dev/null
+++ b/scripts/stop_remote_pod.py
@@ -0,0 +1,73 @@
+"""Verify and stop the specified pod from outside its disposable container.
+
+The pod-injected credential travels over the existing SSH connection, remains
+only in this process's memory, and is never written to output or an artifact.
+Use --execute only after backing up the experiment outputs.
+"""
+import argparse
+import json
+import subprocess
+import time
+import urllib.error
+import urllib.request
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--host", required=True)
+    parser.add_argument("--port", type=int, required=True)
+    parser.add_argument("--identity", required=True)
+    parser.add_argument("--expected-id", required=True)
+    parser.add_argument("--expected-name", required=True)
+    parser.add_argument("--execute", action="store_true")
+    args = parser.parse_args()
+    # Capture this output privately. Never include stdout/stderr in exceptions:
+    # stdout contains the credential on a successful SSH read.
+    remote = """python - <<'PY'
+import json
+from pathlib import Path
+env = dict(x.decode().split('=',1) for x in Path('/proc/1/environ').read_bytes().split(b'\\0') if b'=' in x)
+print(json.dumps({'id': env['RUNPOD_POD_ID'], 'key': env['RUNPOD_API_KEY']}))
+PY"""
+    proc = subprocess.run(["ssh", "-i", args.identity, "-p", str(args.port), "-o", "BatchMode=yes",
+                           "-o", "ConnectTimeout=15", args.host, remote],
+                          capture_output=True, text=True, timeout=45)
+    if proc.returncode:
+        raise SystemExit("Could not read the pod's management credential over SSH")
+    credential = json.loads(proc.stdout)
+    if credential["id"] != args.expected_id:
+        raise SystemExit("Remote container identity does not match the expected pod")
+
+    def request(query):
+        req = urllib.request.Request("https://api.runpod.io/graphql", data=json.dumps({"query": query}).encode(),
+            headers={"Content-Type": "application/json", "Authorization": "Bearer " + credential["key"]})
+        try:
+            with urllib.request.urlopen(req, timeout=25) as response:
+                result = json.load(response)
+        except urllib.error.HTTPError as exc:
+            raise SystemExit(f"Runpod management request returned HTTP {exc.code}") from None
+        if result.get("errors"):
+            raise SystemExit(json.dumps({"errors": [e.get("message") for e in result["errors"]]}))
+        return result["data"]
+
+    query = 'query { pod(input: {podId: ' + json.dumps(args.expected_id) + '}) { id name desiredStatus costPerHr runtime { uptimeInSeconds } } }'
+    pod = request(query)["pod"]
+    if not pod or pod["id"] != args.expected_id or pod["name"] != args.expected_name:
+        raise SystemExit("Pod identity verification failed")
+    print(json.dumps({"verified_current_pod": pod}), flush=True)
+    if args.execute:
+        result = request('mutation { podStop(input: {podId: ' + json.dumps(args.expected_id) + '}) { id desiredStatus } }')
+        print(json.dumps(result), flush=True)
+        if result["podStop"]["desiredStatus"] != "EXITED":
+            raise SystemExit("Stop response did not confirm EXITED")
+        for _ in range(40):
+            final = request(query)["pod"]
+            if final["desiredStatus"] == "EXITED" and final.get("runtime") is None:
+                print(json.dumps({"stopped_pod": final, "gpu_runtime_released": True}), flush=True)
+                return
+            time.sleep(3)
+        raise SystemExit("Stop was requested but GPU runtime release was not confirmed")
+
+
+if __name__ == "__main__":
+    main()
