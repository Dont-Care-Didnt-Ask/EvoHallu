@@ -0,0 +1,92 @@
+"""Time the optional feature model using training claims, without quality tuning."""
+import gc
+import argparse
+import json
+import logging
+import time
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import torch
+from transformers import AutoModelForCausalLM, AutoTokenizer
+
+from packing.evaluate.uncertainty_quantification.precompute_raw_stats_separated import _precompute_split
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--extended-cleanup", action="store_true")
+    parser.add_argument("--output", type=Path, default=Path("out/campaign/small_feature_probe.json"))
+    args = parser.parse_args()
+    logging.getLogger().setLevel(logging.ERROR)
+    torch.set_num_threads(12)
+    model_id = "/dev/shm/mod1-models/Llama3.2-1B"
+    tokenizer_id = "/workspace/mod1-models/llama31"
+    source = AutoTokenizer.from_pretrained(tokenizer_id)
+    target = AutoTokenizer.from_pretrained(model_id)
+    if source.get_vocab() != target.get_vocab():
+        raise ValueError("The shared-tokenizer vocabularies differ")
+    source.padding_side = "right"
+    source.pad_token = source.pad_token or source.eos_token
+    df = pd.read_csv("data/claims/popqa/popqa_train_filtered_10shot.csv", usecols=["claim", "is_hallu"])
+    indices = np.random.default_rng(441).choice(len(df), 256, replace=False)
+    df = df.iloc[indices].copy()
+    model = AutoModelForCausalLM.from_pretrained(model_id, dtype=torch.float32, attn_implementation="sdpa").eval().to("cuda:0")
+    padded_tokens = []
+    hook = model.register_forward_pre_hook(lambda module, inputs, kwargs: padded_tokens.append(kwargs["input_ids"].numel()), with_kwargs=True)
+    original_collect = gc.collect
+    gc_seconds = 0.
+
+    def collect(*args, **kwargs):
+        nonlocal gc_seconds
+        started = time.monotonic()
+        result = original_collect(*args, **kwargs)
+        gc_seconds += time.monotonic()-started
+        return result
+
+    gc.collect = collect
+    started = time.monotonic()
+    try:
+        raw = _precompute_split(df, source, model, "claim", "is_hallu", None, 16,
+                                "generate_true_statement", 512, 1, modalities="logits", max_batch_tokens=16384)["logits_struct"]
+    finally:
+        gc.collect = original_collect
+        hook.remove()
+    elapsed = time.monotonic()-started
+    started = time.monotonic()
+    optimized = _precompute_split(df, source, model, "claim", "is_hallu", None, 16,
+                                "generate_true_statement", 512, 1, modalities="logits",
+                                max_batch_tokens=16384, gc_interval=32)["logits_struct"]
+    optimized_elapsed = time.monotonic()-started
+    identical = all(np.array_equal(np.asarray(a[key]), np.asarray(b[key]))
+                    for a, b in zip(raw["samples"], optimized["samples"])
+                    for key in ["input_ids", "sequence_logprobs", "greedy_logprobs", "token_entropies", "top_k_logits", "top_k_indices"])
+    report = {"model": "unsloth/Llama-3.2-1B-Instruct", "revision": "5a8abab4a5d6f164389b1079fb721cfab8d7126c",
+              "shared_token_to_id_vocabulary_identical": True, "rows": len(df), "seconds": elapsed,
+              "claims_per_second": len(df)/elapsed, "cpu_gc_seconds": gc_seconds,
+              "padded_forward_tokens": sum(padded_tokens), "forwards": len(padded_tokens),
+              "row_rate_projection_for_97488_minutes": elapsed/len(df)*97488/60,
+              "projection_limitation": "Short training claims only; longer held-out claims can take more time",
+              "metadata": raw["meta"], "held_out_quality_metrics_computed": False}
+    report.update(gc32_seconds=optimized_elapsed, gc32_claims_per_second=len(df)/optimized_elapsed,
+                  gc_schedule_features_identical=identical,
+                  gc32_row_rate_projection_minutes=optimized_elapsed/len(df)*97488/60,
+                  timing_limitation="The first pass also includes CUDA warmup; this is an operational timing probe")
+    if args.extended_cleanup:
+        started = time.monotonic()
+        pooled = _precompute_split(df, source, model, "claim", "is_hallu", None, 16,
+                                   "generate_true_statement", 512, 1, modalities="logits",
+                                   max_batch_tokens=16384, gc_interval=32, cuda_cache_interval=32)["logits_struct"]
+        pooled_elapsed = time.monotonic()-started
+        same = all(np.array_equal(np.asarray(a[key]), np.asarray(b[key]))
+                   for a, b in zip(raw["samples"], pooled["samples"])
+                   for key in ["input_ids", "orig_input_ids", "sequence_logprobs", "greedy_logprobs", "token_entropies", "top_k_logits", "top_k_indices"])
+        report.update(cuda32_seconds=pooled_elapsed, cuda32_features_identical=same,
+                      cuda32_row_rate_projection_minutes=pooled_elapsed/len(df)*97488/60)
+    args.output.write_text(json.dumps(report, indent=2)+"\n")
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/campaign.py b/scripts/campaign.py
new file mode 100644
index 0000000000000000000000000000000000000000..995d47868f84670d23400e835e72d272e0c6abee
--- /dev/null
+++ b/scripts/campaign.py
@@ -0,0 +1,157 @@
+"""Resumable, bounded local-GPU campaign. The plan is re-read after each action."""
+import argparse
+import datetime as dt
+import json
+import os
+import signal
+import subprocess
+import time
+import urllib.request
+from pathlib import Path
+
+
+def write(path, value):
+    tmp = path.with_suffix(".tmp")
+    tmp.write_text(json.dumps(value, indent=2) + "\n")
+    tmp.replace(path)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--plan", type=Path, required=True)
+    ap.add_argument("--state", type=Path, default=Path("out/campaign/state.json"))
+    ap.add_argument("--require-cohort-verified", type=Path)
+    args = ap.parse_args()
+    if args.require_cohort_verified:
+        marker = args.require_cohort_verified
+        if not marker.exists() or not json.loads(marker.read_text()).get("common_method_predictions_identical", False):
+            print("Optional plan skipped: its prerequisite cohort is not verified", flush=True)
+            return
+    args.state.parent.mkdir(parents=True, exist_ok=True)
+    state = json.loads(args.state.read_text()) if args.state.exists() else {"completed": [], "events": []}
+    server = None
+    server_stream = None
+    child = None
+    env = os.environ.copy()
+    env.update(PYTHONPATH="src:.", OMP_NUM_THREADS="4", MKL_NUM_THREADS="4", WANDB_DISABLED="true")
+
+    def event(status, **details):
+        row = {"utc": dt.datetime.now(dt.timezone.utc).isoformat(), "status": status, **details}
+        state["events"].append(row)
+        state["current"] = row
+        write(args.state, state)
+        print(json.dumps(row), flush=True)
+
+    def remaining():
+        plan = json.loads(args.plan.read_text())
+        return dt.datetime.fromisoformat(plan["hard_deadline_utc"]).timestamp() - time.time()
+
+    def stop_server():
+        nonlocal server, server_stream
+        if server is not None:
+            if server.poll() is None:
+                os.killpg(server.pid, signal.SIGTERM)
+                try:
+                    server.wait(timeout=30)
+                except subprocess.TimeoutExpired:
+                    os.killpg(server.pid, signal.SIGKILL)
+                    server.wait()
+            server = None
+        if server_stream:
+            server_stream.close()
+            server_stream = None
+
+    try:
+        def interrupt(signum, frame):
+            raise KeyboardInterrupt(f"Campaign interrupted by signal {signum}")
+        signal.signal(signal.SIGTERM, interrupt)
+        while remaining() > 0:
+            plan = json.loads(args.plan.read_text())
+            action = next((a for a in plan["actions"] if a["id"] not in state["completed"]), None)
+            if action is None:
+                event("plan_finished")
+                break
+            if remaining() < float(action.get("minimum_remaining_seconds", 0)):
+                state["completed"].append(action["id"])
+                event("skipped_to_preserve_evaluation_budget", action=action["id"])
+                continue
+            event("starting", action=action["id"], kind=action["kind"])
+            kind = action["kind"]
+            if kind == "wait_file":
+                deadline = time.time() + min(action.get("timeout", 1800), remaining())
+                while not Path(action["path"]).is_file():
+                    if time.time() >= deadline:
+                        raise TimeoutError(f"Waiting for {action['path']}")
+                    time.sleep(5)
+                # torch.save writes atomically only at close; wait for the
+                # precompute's completion message as well as the output file.
+                marker = action.get("log_contains")
+                while marker and marker not in Path(action["log"]).read_text(errors="replace"):
+                    if time.time() >= deadline:
+                        raise TimeoutError("Precompute did not report completion")
+                    time.sleep(2)
+            elif kind == "serve":
+                stop_server()
+                server_stream = open(action["log"], "a")
+                server = subprocess.Popen(action["command"], env=env, stdout=server_stream,
+                                          stderr=subprocess.STDOUT, start_new_session=True)
+                state["server_pid"] = server.pid
+                deadline = time.time() + min(action.get("timeout", 900), remaining())
+                while True:
+                    if server.poll() is not None:
+                        raise RuntimeError(f"Server exited ({server.returncode}); see {action['log']}")
+                    try:
+                        with urllib.request.urlopen("http://127.0.0.1:8000/v1/models", timeout=3) as response:
+                            if response.status == 200:
+                                break
+                    except Exception:
+                        pass
+                    if time.time() >= deadline:
+                        raise TimeoutError("Model server did not become ready")
+                    time.sleep(5)
+                event("server_ready", pid=server.pid)
+            elif kind == "stop_server":
+                stop_server()
+            elif kind == "command":
+                timeout = min(float(action.get("timeout", 3600)), remaining())
+                with open(action["log"], "a") as log:
+                    child = subprocess.Popen(action["command"], env=env, stdout=log, stderr=subprocess.STDOUT,
+                                             start_new_session=True)
+                    state["child_pid"] = child.pid
+                    write(args.state, state)
+                    try:
+                        code = child.wait(timeout=timeout)
+                    except subprocess.TimeoutExpired:
+                        os.killpg(child.pid, signal.SIGTERM)
+                        try:
+                            child.wait(timeout=10)
+                        except subprocess.TimeoutExpired:
+                            os.killpg(child.pid, signal.SIGKILL)
+                            child.wait()
+                        raise TimeoutError(f"Action {action['id']} exceeded {timeout:.0f}s")
+                if code:
+                    event("command_failed", action=action["id"], returncode=code, log=action["log"])
+                    if not action.get("continue_on_failure", False):
+                        raise RuntimeError(f"Action failed: {action['id']}")
+            else:
+                raise ValueError(f"Unknown action kind: {kind}")
+            state["completed"].append(action["id"])
+            event("completed", action=action["id"])
+        else:
+            event("hard_deadline")
+    except BaseException as exc:
+        event("failed", error=f"{type(exc).__name__}: {exc}")
+        raise
+    finally:
+        if child is not None and child.poll() is None:
+            os.killpg(child.pid, signal.SIGTERM)
+            try:
+                child.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                os.killpg(child.pid, signal.SIGKILL)
+                child.wait()
+        stop_server()
+
+
+if __name__ == "__main__":
+    main()
