        {
          "line": 643,
          "text": ""
        },
        {
          "line": 644,
          "text": "    # BIAS: Permute bias"
        },
        {
          "line": 645,
          "text": "    def permute_bias(bias: torch.Tensor | None) -> torch.Tensor | None:"
        },
        {
