        {
          "line": 731,
          "text": "def mxfp4_round_up_hidden_size_and_intermediate_size("
        },
        {
          "line": 732,
          "text": "    backend: Mxfp4MoeBackend,"
        },
        {
          "line": 733,
          "text": "    hidden_size: int,"
        },
        {
          "line": 734,
          "text": "    intermediate_size: int,"
        },
        {
          "line": 735,
          "text": "    activation: MoEActivation | None = None,"
        },
        {
          "line": 736,
          "text": ") -> tuple[int, int]:"
        },
        {
          "line": 737,
          "text": "    \"\"\"Round up hidden_size and intermediate_size based on backend requirements.\"\"\""
        },
        {
          "line": 738,
          "text": "    if backend in B12X_BACKENDS:"
        },
        {
          "line": 739,
          "text": "        # b12x plans for the exact model dimensions. B12xExperts validates the"
        },
        {
          "line": 740,
          "text": "        # required MXFP4 block alignment before selecting the backend."
        },
        {
          "line": 741,
          "text": "        return hidden_size, intermediate_size"
        },
        {
          "line": 742,
          "text": "    if backend == Mxfp4MoeBackend.EMULATION:"
        },
        {
          "line": 743,
          "text": "        # Emulation has no kernel tile; it only needs OCP MX block alignment so the"
        },
        {
          "line": 744,
          "text": "        # per-block scale buffers (`dim // OCP_MX_BLOCK_SIZE`) aren't floor-truncated"
        },
        {
          "line": 745,
          "text": "        # by a non-block-aligned TP/DP shard (e.g. 2880 // 4 = 720)."
        },
        {
          "line": 746,
          "text": "        intermediate_size = round_up(intermediate_size, OCP_MX_BLOCK_SIZE)"
        },
        {
          "line": 747,
          "text": "        hidden_size = round_up(hidden_size, OCP_MX_BLOCK_SIZE)"
        },
        {
          "line": 748,
          "text": "    elif backend == Mxfp4MoeBackend.DEEPGEMM_MXFP4:"
        },
        {
          "line": 749,
          "text": "        # DeepGEMM requires M/N/K alignment"
        },
        {
          "line": 750,
          "text": "        intermediate_size = round_up(intermediate_size, 128)"
        },
        {
          "line": 751,
          "text": "        hidden_size = round_up(hidden_size, 128)"
        },
        {
          "line": 752,
          "text": "    elif backend in (Mxfp4MoeBackend.MARLIN, Mxfp4MoeBackend.BATCHED_MARLIN):"
        },
        {
          "line": 753,
          "text": "        intermediate_size = round_up(intermediate_size, 128)"
        },
        {
          "line": 754,
          "text": "        if current_platform.is_xpu():"
        },
        {
          "line": 755,
          "text": "            hidden_size = round_up(hidden_size, 128)"
        },
        {
          "line": 756,
          "text": "        else:"
        },
        {
          "line": 757,
          "text": "            hidden_size = round_up(hidden_size, 256)"
        },
        {
          "line": 758,
          "text": "    elif backend in TRTLLM_BACKENDS:"
        },
        {
          "line": 759,
          "text": "        intermediate_size = round_up(intermediate_size, 128)"
        },
        {
          "line": 760,
          "text": "        hidden_size = round_up(hidden_size, 256)"
        }
      ]
