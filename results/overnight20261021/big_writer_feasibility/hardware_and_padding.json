        {
          "line": 126,
          "text": "def mxfp4_marlin_process_scales(marlin_scales, input_dtype=None):"
        },
        {
          "line": 127,
          "text": "    # fit the layout of fp8 dequantization"
        },
        {
          "line": 128,
          "text": "    if input_dtype is None or input_dtype.itemsize == 2:"
        },
        {
          "line": 129,
          "text": "        marlin_scales = marlin_scales.view(-1, 4)[:, [0, 2, 1, 3]].view("
        },
        {
          "line": 130,
          "text": "            marlin_scales.size(0), -1"
        },
        {
          "line": 131,
          "text": "        )"
        },
        {
          "line": 132,
          "text": ""
        },
        {
          "line": 133,
          "text": "    marlin_scales = marlin_scales.to(torch.float8_e8m0fnu)"
        },
        {
          "line": 134,
          "text": "    if input_dtype == torch.float8_e4m3fn:"
        },
        {
          "line": 135,
          "text": "        marlin_scales = marlin_scales.view(torch.uint8)"
        },
        {
          "line": 136,
          "text": "        assert marlin_scales.max() <= 249"
        },
        {
          "line": 137,
          "text": "        # exponent_bias (fp4->fp8) = 2 ** 3 - 2 ** 1 = 6"
        },
        {
          "line": 138,
          "text": "        marlin_scales = marlin_scales + 6"
        },
        {
          "line": 139,
          "text": "        marlin_scales = marlin_scales.view(torch.float8_e8m0fnu)"
        },
        {
          "line": 140,
          "text": "    return marlin_scales"
        }
      ]
    },
