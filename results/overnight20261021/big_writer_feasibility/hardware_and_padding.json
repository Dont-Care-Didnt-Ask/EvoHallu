        {
          "line": 570,
          "text": "    torch.Tensor,"
        },
        {
          "line": 571,
          "text": "    torch.Tensor,"
        },
        {
          "line": 572,
          "text": "    torch.Tensor,"
        },
        {
          "line": 573,
          "text": "    torch.Tensor | None,"
        },
        {
          "line": 574,
          "text": "    torch.Tensor | None,"
        },
        {
          "line": 575,
          "text": "]:"
        },
        {
          "line": 576,
          "text": "    \"\"\"Pure-function version of prepare_moe_fp4_layer_for_marlin for MXFP4."
        },
        {
          "line": 577,
          "text": ""
        },
        {
          "line": 578,
          "text": "    Takes weight tensors as inputs and returns transformed tensors."
        },
        {
          "line": 579,
          "text": "    Does NOT modify the layer in-place."
        },
        {
          "line": 580,
          "text": "    \"\"\""
        },
        {
          "line": 581,
          "text": "    input_dtype = get_marlin_input_dtype()"
        },
        {
          "line": 582,
          "text": "    if ("
        },
        {
          "line": 583,
          "text": "        input_dtype is not None"
        },
        {
          "line": 584,
          "text": "        and input_dtype.itemsize == 1"
        },
        {
          "line": 585,
          "text": "        and input_dtype != torch.float8_e4m3fn"
        },
        {
          "line": 586,
          "text": "    ):"
        },
        {
          "line": 587,
          "text": "        raise RuntimeError(\"MXFP4 weight + INT8 activation is not supported.\")"
        },
        {
          "line": 588,
          "text": ""
        },
        {
          "line": 589,
          "text": "    group_size = 32  # MXFP4 block size"
        },
        {
          "line": 590,
          "text": ""
        },
        {
          "line": 591,
          "text": "    # Derive dimensions from actual weight shapes to handle rounded/padded"
        },
        {
          "line": 592,
          "text": "    # sizes correctly (e.g., Mxfp4MoEMethod rounds up hidden_dim)."
        },
        {
          "line": 593,
          "text": "    # w13 shape: (E, 2*N, K//2)"
        },
        {
          "line": 594,
          "text": "    e = w13.shape[0]"
        },
        {
          "line": 595,
          "text": "    n = w13.shape[1] // 2  # intermediate_size_per_partition"
        },
        {
          "line": 596,
          "text": "    k = w13.shape[2] * 2  # hidden_size"
        },
        {
          "line": 597,
          "text": ""
        },
        {
          "line": 598,
          "text": "    param_dtype = layer.params_dtype"
        },
        {
          "line": 599,
          "text": "    is_a_8bit = input_dtype is not None and input_dtype.itemsize == 1"
        },
        {
          "line": 600,
          "text": ""
        },
        {
          "line": 601,
          "text": "    # WEIGHT: Repack weights to marlin format"
        },
        {
          "line": 602,
          "text": "    def repack_weight(weight: torch.Tensor, name: str) -> torch.Tensor:"
        },
        {
          "line": 603,
          "text": "        if \"w13\" in name:"
        },
        {
          "line": 604,
          "text": "            size_n, size_k = n * 2, k"
        },
        {
          "line": 605,
          "text": "        else:"
        },
        {
          "line": 606,
          "text": "            size_n, size_k = k, n"
        },
        {
          "line": 607,
          "text": ""
        },
        {
          "line": 608,
          "text": "        assert weight.shape == (e, size_n, size_k // 2)"
        },
        {
          "line": 609,
          "text": ""
        },
        {
          "line": 610,
          "text": "        return _repack_marlin_experts(weight, size_n, size_k, is_a_8bit)"
        },
        {
          "line": 611,
          "text": ""
        },
        {
          "line": 612,
          "text": "    w13 = repack_weight(w13, \"w13\")"
        },
        {
          "line": 613,
          "text": "    w2 = repack_weight(w2, \"w2\")"
        },
        {
          "line": 614,
          "text": ""
        },
        {
          "line": 615,
          "text": "    # WEIGHT SCALES: Permute scales"
        },
        {
          "line": 616,
          "text": "    def permute_scales(scales: torch.Tensor, name: str) -> torch.Tensor:"
        },
        {
          "line": 617,
          "text": "        scales = scales.view(torch.float8_e8m0fnu)"
        },
        {
          "line": 618,
          "text": "        scales = scales.to(param_dtype)"
        },
        {
          "line": 619,
          "text": ""
        },
        {
          "line": 620,
          "text": "        tensor_list = []"
        },
        {
          "line": 621,
          "text": "        if \"w13\" in name:"
        },
        {
          "line": 622,
          "text": "            size_n, size_k = n * 2, k"
        },
        {
          "line": 623,
          "text": "        else:"
        },
        {
          "line": 624,
          "text": "            size_n, size_k = k, n"
        },
        {
          "line": 625,
          "text": ""
        },
        {
          "line": 626,
          "text": "        for i in range(e):"
        },
        {
          "line": 627,
          "text": "            scale = scales[i].T"
        },
        {
          "line": 628,
          "text": "            marlin_scales = marlin_permute_scales("
        },
        {
          "line": 629,
          "text": "                s=scale,"
        },
        {
          "line": 630,
          "text": "                size_k=size_k,"
        },
        {
          "line": 631,
          "text": "                size_n=size_n,"
        },
        {
          "line": 632,
          "text": "                group_size=group_size,"
        },
        {
          "line": 633,
          "text": "                is_a_8bit=is_a_8bit,"
        },
        {
          "line": 634,
          "text": "            )"
        },
        {
          "line": 635,
          "text": "            marlin_scales = mxfp4_marlin_process_scales("
        },
        {
          "line": 636,
          "text": "                marlin_scales, input_dtype=input_dtype"
        },
        {
          "line": 637,
          "text": "            )"
        },
        {
          "line": 638,
          "text": "            tensor_list.append(marlin_scales)"
        },
        {
          "line": 639,
          "text": "        return torch.cat([x.unsqueeze(0) for x in tensor_list], 0)"
        },
        {
          "line": 640,
          "text": ""
        },
        {
          "line": 641,
          "text": "    w13_scale = permute_scales(w13_scale, \"w13\")"
        },
        {
          "line": 642,
          "text": "    w2_scale = permute_scales(w2_scale, \"w2\")"
